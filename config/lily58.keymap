#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <28 31>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <14 15>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <15 16>;
        };

        lp {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        lb {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <28 29>;
        };

        lfb {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <41 40>;
        };

        rfb {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <44 45>;
        };

        rp {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <18 19>;
        };

        rb {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <31 30>;
        };

        lt {
            bindings = <&kp LESS_THAN>;
            key-positions = <46 47>;
        };

        gt {
            bindings = <&kp GREATER_THAN>;
            key-positions = <47 48>;
        };
    };

    behaviors {
        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC       &kp N1  &kp N2  &kp N3  &kp N4    &kp N5                           &kp N6     &kp N7    &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB       &kp Q   &kp W   &kp E   &kp R     &kp T                            &kp Y      &kp U     &kp I      &kp O    &kp P     &kp LEFT_BRACE
&kp CAPSLOCK  &kp A   &kp S   &kp D   &kp F     &kp G                            &kp H      &kp J     &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL     &kp Z   &kp X   &kp C   &kp V     &kp B      &kp LBKT    &kp RBKT  &kp N      &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_BRACE
                              &trans  &kp LGUI  &kp SPACE  &mo 1       &mo 2     &kp ENTER  &kp BSPC  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // --------------------------------------------------------------------------------------------------------------
            // | LPAD  | BRDn | BRUp |  MUT |  Vo- |  Vo+ |                   |      |       |       |      |       |       |
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !   |  @   |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |      |      |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp GRAVE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                       &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&kp F1     &kp F2           &kp F3       &kp F4    &kp F5      &kp F6                            &kp F7     &kp F8         &kp F9        &kp F10               &kp F11                &kp F12
&trans     &trans           &trans       &trans    &trans      &msc SCRL_UP                      &trans     &trans         &trans        &trans                &trans                 &trans
&trans     &kp F4           &trans       &kp F12   &trans      &msc SCRL_DOWN  &trans    &trans  &trans     &trans         &trans        &trans                &trans                 &trans
                                         &trans    &trans      &trans          &trans    &trans  &trans     &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&studio_unlock  &bt BT_SEL 0  &bt BT_SEL 1  &trans  &trans  &trans                    &trans    &kp C_VOLUME_DOWN  &kp K_MUTE    &kp C_VOL_UP     &trans  &trans
&trans          &trans        &trans        &trans  &trans  &trans                    &trans    &trans             &trans        &trans           &trans  &trans
&trans          &trans        &trans        &trans  &trans  &trans                    &kp LEFT  &kp DOWN           &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans          &trans        &trans        &trans  &trans  &trans  &trans    &trans  &trans    &trans             &trans        &trans           &trans  &trans
                                            &trans  &trans  &trans  &trans    &trans  &trans    &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
